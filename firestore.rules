rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function masterAccount() {
      return signedIn() && request.auth.token.email == 'binhhu19802014@gmail.com';
    }
    function meta(ws) {
      return get(/databases/$(database)/documents/workspaces/$(ws)/config/meta).data;
    }
    function isWorkspaceOwner(ws) {
      return masterAccount() && meta(ws).ownerUid == request.auth.uid;
    }

    // Toàn bộ dữ liệu Cloud chỉ chấp nhận tài khoản Firebase dùng chung duy nhất.
    match /workspaces/{ws}/config/meta {
      allow create: if masterAccount()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerEmail == 'binhhu19802014@gmail.com';
      allow read, update, delete: if masterAccount() && resource.data.ownerUid == request.auth.uid;
    }

    match /workspaces/{ws}/state/{docId} {
      allow read, write: if isWorkspaceOwner(ws);
    }

    match /workspaces/{ws}/photos/{docId} {
      allow read, write: if isWorkspaceOwner(ws);
    }
  }
}
